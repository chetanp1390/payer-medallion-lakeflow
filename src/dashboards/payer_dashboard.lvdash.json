    {
      "displayName": "Top diagnoses",
      "name": "c8bcf12b",
      "queryLines": [
        "SELECT diagnosis_code, diagnosis_desc,\r\n",
        "       COUNT(DISTINCT claim_id) AS claims\r\n",
        "FROM payer_demo.payor_gold.claim_diagnosis\r\n",
        "GROUP BY ALL\r\n",
        "ORDER BY claims DESC\r\n",
        "LIMIT 15"
      ]
    }
