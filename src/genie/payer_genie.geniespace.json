      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  MEASURE(`denial_rate`) AS `denial_rate`\n",
              "FROM\n",
              "  `payer_demo`.`payor_gold`.`claims_metrics`\n",
              "GROUP BY\n",
              "  ALL"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd33bfc1542b80436fd0710e5b1",
        "question": [
          "What is our overall denial rate?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT COUNT(*) AS claims FROM payer_demo.payor_gold.fact_claims"
