{
  "benchmarks": {
    "questions": [
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  p.`provider_id`,\n",
              "  p.`provider_name`,\n",
              "  p.`specialty`,\n",
              "  COUNT(c.`claim_id`) AS `total_claims`,\n",
              "  SUM(\n",
              "    CASE\n",
              "      WHEN c.`claim_status` = 'denied' THEN 1\n",
              "      ELSE 0\n",
              "    END\n",
              "  ) AS `denied_claims`,\n",
              "  (\n",
              "    SUM(\n",
              "      CASE\n",
              "        WHEN c.`claim_status` = 'denied' THEN 1\n",
              "        ELSE 0\n",
              "      END\n",
              "    )\n",
              "      * 100.0\n",
              "      / COUNT(c.`claim_id`)\n",
              "  ) AS `denial_rate`\n",
              "FROM\n",
              "  `payer_demo`.`payor_gold`.`fact_claims` c\n",
              "    JOIN `payer_demo`.`payor_gold`.`dim_provider` p\n",
              "      ON c.`provider_id` = p.`provider_id`\n",
              "GROUP BY\n",
              "  p.`provider_id`,\n",
              "  p.`provider_name`,\n",
              "  p.`specialty`\n",
              "HAVING\n",
              "  COUNT(c.`claim_id`) >= 20\n",
              "ORDER BY\n",
              "  `denial_rate` DESC\n",
              "LIMIT 5"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd3c4951a809b6c2204b3089ef1",
        "question": [
          "Which 5 providers with at least 20 claims have the highest denial rate?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT ROUND(SUM(total_charge), 2) AS total_charges FROM payer_demo.payor_gold.fact_claims WHERE claim_id IN (SELECT claim_id FROM payer_demo.payor_gold.claim_diagnosis WHERE diagnosis_desc ILIKE '%hypertension%')"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd3bde01320bdafedf7dff0eab9",
        "question": [
          "Total charges for claims with a hypertension diagnosis"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT ROUND(SUM(total_charge), 2) AS total_charges FROM payer_demo.payor_gold.fact_claims WHERE diagnosis_count > 1"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd3b23c1422803b4414f07f2217",
        "question": [
          "Total charges for claims with more than one diagnosis"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT diagnosis_code, diagnosis_desc, COUNT(DISTINCT claim_id) AS claims FROM payer_demo.payor_gold.claim_diagnosis GROUP BY diagnosis_code, diagnosis_desc ORDER BY claims DESC LIMIT 5"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd3a8b21d019cebe0f34cadfcae",
        "question": [
          "Top 5 diagnoses by number of claims"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT COUNT(DISTINCT member_id) AS members_with_claims FROM payer_demo.payor_gold.fact_claims"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd39d8e1db8aa84ca7bfd360fed",
        "question": [
          "How many members had at least one claim?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT p.state, ROUND(AVG(f.total_charge), 2) AS avg_charge_per_claim FROM payer_demo.payor_gold.fact_claims f JOIN payer_demo.payor_gold.dim_provider p ON f.provider_id = p.provider_id GROUP BY p.state ORDER BY avg_charge_per_claim DESC"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd397d11fc7bf6743527ba75c0d",
        "question": [
          "Average charge per claim by provider state"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  `claim_month`,\n",
              "  MEASURE(`denial_rate`) AS `denial_rate`\n",
              "FROM\n",
              "  `payer_demo`.`payor_gold`.`claims_metrics`\n",
              "GROUP BY\n",
              "  ALL\n",
              "ORDER BY\n",
              "  `claim_month` ASC"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd37abd1240aaf2c2bfc3061cdb",
        "question": [
          "Show denial rate by month"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  `dp`.`specialty`,\n",
              "  SUM(`fc`.`total_charge`) AS `total_charges`\n",
              "FROM\n",
              "  `payer_demo`.`payor_gold`.`fact_claims` AS `fc`\n",
              "    JOIN `payer_demo`.`payor_gold`.`dim_provider` AS `dp`\n",
              "      ON `fc`.`provider_id` = `dp`.`provider_id`\n",
              "WHERE\n",
              "  `dp`.`specialty` IS NOT NULL\n",
              "GROUP BY\n",
              "  `dp`.`specialty`\n",
              "ORDER BY\n",
              "  `total_charges` DESC"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd370ca1b1081a8d89f6363309f",
        "question": [
          "Which provider specialty has the highest total charges?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT m.plan_id, ROUND(SUM(f.total_charge), 2) AS total_charges FROM payer_demo.payor_gold.fact_claims f JOIN payer_demo.payor_gold.dim_member m ON f.member_id = m.member_id GROUP BY m.plan_id ORDER BY total_charges DESC"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd3645c1d59b56a6718d155c398",
        "question": [
          "Total billed amount by plan"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  MEASURE(`denial_rate`) AS `denial_rate`\n",
              "FROM\n",
              "  `payer_demo`.`payor_gold`.`claims_metrics`\n",
              "GROUP BY\n",
              "  ALL"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bdd3571f15d6b537c1d700521ab5",
        "question": [
          "What's our rejection rate?"
